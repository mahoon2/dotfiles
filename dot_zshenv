# ~/.zshenv — sourced by every zsh (interactive, non-interactive, scripts).
# Machine-independent environment. User-space tool paths live in
# ~/.zsh/path.sh, which ~/.zprofile re-applies after macOS path_helper.
# Host-specific entries (e.g. a version-pinned node) belong in ~/.zshrc.local.

# General environment
export EDITOR=nvim
export PAGER=less
export CUDA_DEVICE_ORDER=PCI_BUS_ID

# Tool-specific environment
export GOPATH="$HOME/go"
export CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=yes
# Codex desktop's SSH bootstrap spawns a leaked app-server per connection
# (its cleanup pkill pattern never matches what it spawns); skip the boot.
# export CODEX_SSH_SKIP_APP_SERVER_BOOT=true

typeset -U path PATH
[[ -r "$HOME/.zsh/path.sh" ]] && source "$HOME/.zsh/path.sh"
