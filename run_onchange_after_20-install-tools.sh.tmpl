#!/usr/bin/env bash
# Install the CLI tools these dotfiles assume. Order of preference: official
# installer, then a language package manager (cargo, uv, go), then pixi global
# for the rest. Reruns when this script or the pixi manifest changes.
# pixi-global.toml: {{ include "dot_pixi/manifests/pixi-global.toml" | sha256sum }}

set -euo pipefail

LAZYGIT_VERSION=v0.66.2
CARGO_CRATES=(eza fd-find ripgrep)
UV_TOOLS=(ruff ty marimo pre-commit)

log() { printf '[install-tools] %s\n' "$*"; }

. "$HOME/.zsh/path.sh"

log "syncing pixi global tools"
pixi global sync

log "installing cargo crates: ${CARGO_CRATES[*]}"
cargo install --locked --quiet "${CARGO_CRATES[@]}"

log "installing uv tools: ${UV_TOOLS[*]}"
for tool in "${UV_TOOLS[@]}"; do
  uv tool install --quiet "$tool"
done

if ! command -v zoxide >/dev/null 2>&1; then
  log "installing zoxide"
  curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
fi

if [[ ! -d "$HOME/.fzf/.git" ]]; then
  log "cloning fzf"
  git clone --depth 1 --quiet https://github.com/junegunn/fzf.git "$HOME/.fzf"
fi
"$HOME/.fzf/install" --bin >/dev/null

log "installing lazygit $LAZYGIT_VERSION"
go install "github.com/jesseduffield/lazygit@$LAZYGIT_VERSION"
